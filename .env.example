# Copy to .env and fill in. Put the real file ONE FOLDER ABOVE public_html on Hostinger
# (e.g. /home/u123456789/.env) so it is never public and never overwritten by a deploy.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if you add a webhook in the Razorpay dashboard (recommended for live)
RAZORPAY_WEBHOOK_SECRET=
